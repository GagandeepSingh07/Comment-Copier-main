{
  "name": "comment-copier",
  "version": "1.16.3",
  "description": "Comment Copier — Unique Every Time. Copy unique accept/reject comments for grading.",
  "main": "main.js",
  "author": "@gagan.design.07",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --config.directories.output=\"%TEMP%\\comment-copier-build\"",
    "build:x64": "electron-builder --win nsis --x64",
    "build:arm64": "electron-builder --win nsis --arm64",
    "build:portable": "electron-builder --win portable --x64"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.commentcopier.app",
    "productName": "Comment Copier",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "shared-data.js",
      "i18n.js",
      "popup.html",
      "popup.css",
      "popup.js",
      "popup-preload.js",
      "mainwindow.html",
      "mainwindow.css",
      "mainwindow.js",
      "mainwindow-preload.js",
      "signatures",
      "build/tray.png",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName} Setup ${version} ${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    }
  }
}
